# Copy to .env in this same folder before running the agent.

SERVER_URL=http://localhost:8000
# One-time enrollment token generated by an admin via POST /api/agent/enrollment-tokens/.
# Only needed for the first run — once enrolled, the device credential is stored
# encrypted (Windows DPAPI) in credentials.dat and this value is no longer used.
ENROLLMENT_TOKEN=
MONITOR_INTERVAL=15
SCREEN_MONITOR_ENABLED=false
