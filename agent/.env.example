# Copy to .env in this same folder before running the agent.
#
# INSTALLED_VIA_MSI=true is a marker written by the MSI installer (see
# installer/build.ps1), not something to set by hand here — a device with
# that marker automatically gets any *new* monitor flag added in a future
# agent version defaulted to true (see config/settings.py's
# _ensure_msi_defaults), instead of the opt-in-false default below that
# manually-configured devices (no marker) keep using.

SERVER_URL=http://localhost:8000
# Opsional: Jika dikosongkan, perangkat akan otomatis terdaftar (Auto-Register)
# dan berstatus "Pending Approval" di Dashboard Devices sampai admin meng-approve.
ENROLLMENT_TOKEN=
MONITOR_INTERVAL=15
SCREEN_MONITOR_ENABLED=false
# All of the below default to false (opt-in per device), same as SCREEN_MONITOR_ENABLED.
USB_MONITOR_ENABLED=false
APP_USAGE_MONITOR_ENABLED=false
BROWSER_HISTORY_MONITOR_ENABLED=false
FILE_ACTIVITY_MONITOR_ENABLED=false
# Active-vs-idle time per day, from GetLastInputInfo (when input last
# happened, never what it was — not a keylogger).
IDLE_ACTIVITY_MONITOR_ENABLED=false
# Error/Critical entries from the device's own local Windows Event Log
# (System + Application channels) — driver crashes, hardware failures,
# unexpected shutdowns. Read-only diagnostics, nothing is ever injected.
SYSTEM_ERROR_MONITOR_ENABLED=false
