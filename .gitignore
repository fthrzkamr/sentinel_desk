# Env / secrets
.env
.env.*
!.env.example
!.env.prod.example

# Sensitive source data (real PII — NIK/KTP/KK numbers, bank accounts, home
# addresses — used to seed the org structure via a one-off import, never
# meant to sit in version control)
*.xlsx
*.xls

# Python
backend/venv/
__pycache__/
*.pyc
backend/staticfiles/
backend/media/
backend/celerybeat-schedule
*.sqlite3

# Node / frontend
frontend/node_modules/
frontend/dist/

# Agent
agent/build/
agent/dist/
agent/*.spec.bak
agent/venv/
agent/credentials.dat
agent/logs/
agent/.env

# MSI installer build output (WiX build dir + bundled frozen .exe payload +
# the built .msi itself - all regenerated by build.ps1, not source)
agent/installer/.wix/
agent/installer/payload/
agent/installer/*.msi
agent/installer/*.wixpdb

# Docker
postgres_data/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
