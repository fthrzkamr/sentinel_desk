# Stage 1 — build static assets
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage 2 — serve them. This container only serves static files; the root
# nginx/ service in front of it handles TLS termination and routes /api and
# /ws to the backend, so this nginx.conf just needs to serve the SPA
# (falling back to index.html for client-side routing).
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
