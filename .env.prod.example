# Copy to .env.prod and fill in real values before using docker-compose.prod.yml.
# Never commit .env.prod. Deliberately a SEPARATE file from .env (dev) so a
# copy-paste mistake can't accidentally run the backend with development
# settings (DEBUG=True, debug_toolbar not even installed in the prod image)
# against a real deployment.
#
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# (--env-file is required — without it, ${POSTGRES_DB} etc. below resolve to
# nothing and postgres refuses to start.)

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_TIME_ZONE=Asia/Jakarta
# Real domain(s) this is served from — no localhost/IP in a real deployment.
DJANGO_ALLOWED_HOSTS=example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
# Leave false until nginx/conf.d/default.conf actually terminates TLS with a
# real certificate (443 block uncommented) — true without that just makes
# every request redirect-loop. See the comment in config/settings/production.py.
DJANGO_HTTPS_ENABLED=false

# --- Database ---
POSTGRES_DB=sentineldesk
POSTGRES_USER=sentineldesk
POSTGRES_PASSWORD=change-me-to-a-long-random-value
DATABASE_URL=postgres://sentineldesk:change-me-to-a-long-random-value@postgres:5432/sentineldesk

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- SentinelDesk domain settings (same meaning as dev, tune as needed) ---
DEVICE_OFFLINE_THRESHOLD_SECONDS=60
DEFAULT_MONITOR_INTERVAL_SECONDS=15
ENROLLMENT_TOKEN_TTL_MINUTES=60
DEVICE_METRIC_RETENTION_DAYS=7
CPU_WARNING_PERCENT=80
CPU_CRITICAL_PERCENT=95
RAM_WARNING_PERCENT=80
RAM_CRITICAL_PERCENT=95
DISK_WARNING_PERCENT=85
DISK_CRITICAL_PERCENT=95
BATTERY_CRITICAL_PERCENT=10
IP_GEOLOCATION_API_URL=http://ip-api.com/json/
IP_GEOLOCATION_TIMEOUT_SECONDS=5

# --- Sentry (optional — prod.txt already includes sentry-sdk) ---
# SENTRY_DSN=
