# Copy this file to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Jakarta
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Database ---
POSTGRES_DB=sentineldesk
POSTGRES_USER=sentineldesk
POSTGRES_PASSWORD=change-me
# Host-side port (for GUI DB clients); change if 5433 is also taken.
POSTGRES_PORT=5433
# Used by the backend container itself — "postgres" is the Docker service
# name, always on port 5432 internally regardless of POSTGRES_PORT above.
DATABASE_URL=postgres://sentineldesk:change-me@postgres:5432/sentineldesk

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- CORS (frontend dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- SentinelDesk domain settings ---
DEVICE_OFFLINE_THRESHOLD_SECONDS=60
DEFAULT_MONITOR_INTERVAL_SECONDS=15
ENROLLMENT_TOKEN_TTL_MINUTES=60
DEVICE_METRIC_RETENTION_DAYS=7
CPU_WARNING_PERCENT=80
CPU_CRITICAL_PERCENT=95
RAM_WARNING_PERCENT=80
RAM_CRITICAL_PERCENT=95
DISK_WARNING_PERCENT=85
DISK_CRITICAL_PERCENT=95
BATTERY_CRITICAL_PERCENT=10
IP_GEOLOCATION_API_URL=http://ip-api.com/json/
IP_GEOLOCATION_TIMEOUT_SECONDS=5

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws
